rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().active == true;
    }

    function isSuperAdmin() {
      return isActiveAdmin() && adminDoc().role == 'super_admin';
    }

    // Account hierarchy: super_admin(3) > admin(2) > every staff role(1).
    function levelForRole(role) {
      return role == 'super_admin' ? 3 : (role == 'admin' ? 2 : 1);
    }

    function actorLevel() {
      return levelForRole(adminDoc().role);
    }

    // Only Admin level and above, holding the `users` permission, may delegate accounts.
    function canDelegate() {
      return isActiveAdmin()
        && actorLevel() >= 2
        && ('users' in adminDoc().permissions);
    }

    // A written profile must sit strictly below the actor and carry no permission the actor lacks.
    function delegatesTo(uid) {
      return canDelegate()
        && request.auth.uid != uid
        && request.resource.data.permissions is list
        && levelForRole(request.resource.data.role) < actorLevel()
        && request.resource.data.permissions.hasOnly(adminDoc().permissions);
    }

    function ownsTarget(uid) {
      return canDelegate()
        && request.auth.uid != uid
        && levelForRole(resource.data.role) < actorLevel();
    }

    function isPublicContent(collection) {
      return collection in [
        'settings', 'homepage', 'about', 'copy', 'why', 'trust',
        'team', 'fleet', 'services', 'gallery', 'testimonials',
        'faq', 'blog', 'advertisements', 'seo', 'pageHeaders', 'cms', 'media', 'locations'
      ];
    }

    // Knowledge writes from CMS admin approve UI (Admin SDK ingestion bypasses rules)
    function isValidKnowledgeWrite() {
      return request.resource.data.keys().hasAll([
          'id', 'type', 'language', 'title', 'content', 'source', 'sourcePath', 'updatedAt', 'version'
        ])
        && request.resource.data.id == id
        && request.resource.data.language in ['ar', 'en']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 50000;
    }

    // Anonymous chatbot conversation schema (sessionId == conversationId == doc id)
    function isValidAiConversationWrite() {
      return request.resource.data.keys().hasOnly([
          'conversationId', 'sessionId', 'language', 'startedAt', 'lastMessageAt', 'summary',
          'customerContext', 'status', 'leadStatus', 'lastIntent', 'leadId',
          'visitorName', 'visitorPhone', 'visitorEmail'
        ])
        && request.resource.data.keys().hasAll([
          'conversationId', 'sessionId', 'language', 'startedAt', 'lastMessageAt', 'summary',
          'customerContext', 'status', 'leadStatus'
        ])
        && request.resource.data.conversationId == conversationId
        && request.resource.data.sessionId == conversationId
        && request.resource.data.language in ['ar', 'en']
        && request.resource.data.status in ['active', 'closed']
        && request.resource.data.leadStatus in ['none', 'potential', 'handoff']
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 2000
        && request.resource.data.customerContext is map
        && request.resource.data.startedAt is string
        && request.resource.data.startedAt.size() <= 40
        && request.resource.data.lastMessageAt is string
        && request.resource.data.lastMessageAt.size() <= 40
        && (!('lastIntent' in request.resource.data)
            || (request.resource.data.lastIntent is string
                && request.resource.data.lastIntent.size() <= 64))
        && (!('leadId' in request.resource.data)
            || (request.resource.data.leadId is string
                && request.resource.data.leadId.size() <= 80))
        && (!('visitorName' in request.resource.data)
            || (request.resource.data.visitorName is string
                && request.resource.data.visitorName.size() <= 120))
        && (!('visitorPhone' in request.resource.data)
            || (request.resource.data.visitorPhone is string
                && request.resource.data.visitorPhone.size() <= 40))
        && (!('visitorEmail' in request.resource.data)
            || (request.resource.data.visitorEmail is string
                && request.resource.data.visitorEmail.size() <= 200));
    }

    function ownsAiConversation() {
      return resource.data.sessionId == conversationId
        && resource.data.conversationId == conversationId;
    }

    function isValidAiMessageCreate() {
      return exists(/databases/$(database)/documents/aiConversations/$(conversationId))
        && get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.sessionId == conversationId
        && get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.conversationId == conversationId
        && request.resource.data.keys().hasOnly([
            'id', 'role', 'content', 'timestamp', 'intent', 'entities',
            'retrievedKnowledgeIds', 'confidence'
          ])
        && request.resource.data.keys().hasAll(['id', 'role', 'content', 'timestamp'])
        && request.resource.data.id == messageId
        && request.resource.data.role in ['user', 'assistant']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;
    }

    // First Super Admin bootstrap lock
    match /config/bootstrap {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/config/bootstrap);
      allow update, delete: if false;
    }

    // Admin profiles — not public
    match /admins/{uid} {
      allow read: if isActiveAdmin() || (signedIn() && request.auth.uid == uid);
      // super_admin is a single account minted once at bootstrap; nobody can hand it out later.
      allow create: if (isSuperAdmin() && request.resource.data.role != 'super_admin')
        || delegatesTo(uid)
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == 'super_admin'
          && request.resource.data.active == true
          && !exists(/databases/$(database)/documents/config/bootstrap)
        );
      allow update: if (
          isSuperAdmin()
          && (request.resource.data.role != 'super_admin' || resource.data.role == 'super_admin')
        )
        || (delegatesTo(uid) && ownsTarget(uid));
      allow delete: if isSuperAdmin() || ownsTarget(uid);
    }

    // Contact leads — public can create only; admins manage
    match /messages/{id} {
      allow read: if isActiveAdmin();
      allow create: if request.resource.data.keys().hasAll([
          'id', 'name', 'email', 'message', 'date', 'status', 'source'
        ])
        && request.resource.data.id == id
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'contact-form'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 40;
      allow update, delete: if isActiveAdmin();
    }

    // Uploaded media registry (Storage HTTPS url and/or legacy dataUrl) — public read
    match /media/{id} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Legacy AI auth-user registry — no credentials stored; lock client self-registration
    match /aiServiceAccounts/{uid} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if false;
    }

    // AI knowledge base — server-side via Admin SDK; client read/write for active admins only
    match /knowledgeDocuments/{id} {
      allow read: if isActiveAdmin();
      allow create, update: if isActiveAdmin() && isValidKnowledgeWrite();
      allow delete: if isActiveAdmin();
    }

    // AI conversations — anonymous chatbot may access only own session doc (id == sessionId)
    match /aiConversations/{conversationId} {
      allow read: if isActiveAdmin() || ownsAiConversation();
      allow create: if isValidAiConversationWrite();
      allow update: if isActiveAdmin()
        || (
          ownsAiConversation()
          && isValidAiConversationWrite()
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.startedAt == resource.data.startedAt
        );

      match /messages/{messageId} {
        allow read: if isActiveAdmin()
          || (
            exists(/databases/$(database)/documents/aiConversations/$(conversationId))
            && get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.sessionId == conversationId
          );
        allow create: if isValidAiMessageCreate();
        allow update, delete: if false;
      }
    }

    // Knowledge learning candidates — Admin SDK create only; admins review
    match /knowledgeCandidates/{id} {
      allow read, update, delete: if isActiveAdmin();
      allow create: if false;
    }

    // AI agent leads — Admin SDK create only; admins manage
    match /aiLeads/{id} {
      allow read, update, delete: if isActiveAdmin();
      allow create: if false;
    }

    // Usage / error logs — admin read only; writes via Admin SDK
    match /aiUsageLogs/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    // CMS → knowledge reingest flag — admin read/write
    match /knowledgeSync/{id} {
      allow read, write: if isActiveAdmin();
    }

    // Public marketing content
    match /{collection}/{document} {
      allow read: if isPublicContent(collection);
      allow write: if isActiveAdmin() && isPublicContent(collection);
    }
  }
}
