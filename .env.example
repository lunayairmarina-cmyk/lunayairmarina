# Firebase Web SDK (public client config — still required at build/runtime).
# Never commit real production secrets beyond standard Firebase web keys.
# Create .env locally and fill every required value. There are no code fallbacks.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Set to 1 only after Storage rules + CORS are deployed for this project.
# Default (unset/0): images save permanently to Firestore `media` collection.
# VITE_FIREBASE_STORAGE_UPLOADS=0

# Public site URL used for Open Graph / WhatsApp / sitemap (no trailing slash)
VITE_SITE_URL=https://www.lunayairmarina.com

# Server-only Gemini key for the AI chatbot (never expose to the client).
# Completely separate from Firebase Admin / service account credentials.
GEMINI_API_KEY=

# Server-only Firebase Admin SDK for knowledge ingestion + chat persistence on Vercel.
# Create: Firebase Console → Project settings → Service accounts → Generate new private key.
# Prefer JSON env on Vercel (no file path available in serverless):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
# Local file alternative (gitignored; keep under secrets/):
# FIREBASE_PROJECT_ID=lunayairmarina-2d694
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional chatbot tuning (server-only)
# GEMINI_MODEL=gemini-3.5-flash-lite
# CHATBOT_MAX_MESSAGE_LENGTH=1000
# CHATBOT_GEMINI_HISTORY_ITEMS=12
# CHATBOT_GEMINI_HISTORY_TOKENS=6000
# CHATBOT_MAX_MESSAGES_PER_SESSION=50
# CHATBOT_RATE_LIMIT_PER_MINUTE=10
# CHATBOT_RATE_LIMIT_WINDOW_MS=60000
# CHATBOT_MAX_OUTPUT_TOKENS=512
# CHATBOT_REQUEST_TIMEOUT_MS=20000
# CHATBOT_RETRIEVAL_DEBUG=0
