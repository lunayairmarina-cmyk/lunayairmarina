{
  "rules": [
    {
      "id": "pricing_with_yacht_context",
      "when": { "clusters": ["pricing"], "lastIntentPrefix": "YACHT" },
      "resolveTo": "YACHT_MANAGEMENT_PRICING"
    },
    {
      "id": "pricing_with_crew_context",
      "when": { "clusters": ["pricing"], "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_PRICING"
    },
    {
      "id": "pricing_with_agency_context",
      "when": { "clusters": ["pricing"], "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_AGENCY"
    },
    {
      "id": "pricing_with_marina_context",
      "when": { "clusters": ["pricing"], "lastIntentPrefix": "MARINA" },
      "resolveTo": "MARINA_MANAGEMENT"
    },
    {
      "id": "pricing_short_followup",
      "when": { "clusters": ["pricing"], "shortMessage": true, "lastIntent": "YACHT_MANAGEMENT" },
      "resolveTo": "YACHT_MANAGEMENT_PRICING"
    },
    {
      "id": "pricing_short_followup_crew",
      "when": { "clusters": ["pricing"], "shortMessage": true, "lastIntent": "CREW_MANAGEMENT" },
      "resolveTo": "CREW_PRICING"
    },
    {
      "id": "pricing_short_followup_visiting",
      "when": { "clusters": ["pricing"], "shortMessage": true, "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_AGENCY"
    },
    {
      "id": "pricing_short_followup_marina",
      "when": { "clusters": ["pricing"], "shortMessage": true, "lastIntentPrefix": "MARINA" },
      "resolveTo": "MARINA_MANAGEMENT"
    },
    {
      "id": "address_followup",
      "when": { "clusters": ["address_contact"], "shortMessage": true },
      "resolveTo": "ADDRESS"
    },
    {
      "id": "phone_followup",
      "when": { "clusters": ["phone_contact"], "shortMessage": true },
      "resolveTo": "PHONE"
    },
    {
      "id": "whatsapp_followup",
      "when": { "clusters": ["whatsapp_contact"], "shortMessage": true },
      "resolveTo": "WHATSAPP"
    },
    {
      "id": "whatsapp_explicit",
      "when": { "clusters": ["whatsapp_contact"] },
      "resolveTo": "WHATSAPP"
    },
    {
      "id": "training_with_crew_context",
      "when": { "clusters": ["training"], "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_TRAINING"
    },
    {
      "id": "training_short_followup",
      "when": { "clusters": ["training"], "shortMessage": true, "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_TRAINING"
    },
    {
      "id": "payroll_with_crew_context",
      "when": { "concepts": ["payroll"], "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_SALARIES"
    },
    {
      "id": "payroll_short_followup",
      "when": { "concepts": ["payroll"], "shortMessage": true, "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_SALARIES"
    },
    {
      "id": "permits_with_visiting_context",
      "when": { "concepts": ["permits"], "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_PERMITS"
    },
    {
      "id": "permits_short_followup",
      "when": { "concepts": ["permits"], "shortMessage": true, "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_PERMITS"
    },
    {
      "id": "clearance_with_visiting_context",
      "when": { "concepts": ["clearance"], "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_CLEARANCE"
    },
    {
      "id": "clearance_short_followup",
      "when": { "concepts": ["clearance"], "shortMessage": true, "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_CLEARANCE"
    },
    {
      "id": "provisioning_with_visiting_context",
      "when": { "clusters": ["provisioning"], "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_PROVISIONING"
    },
    {
      "id": "provisioning_short_followup",
      "when": { "clusters": ["provisioning"], "shortMessage": true, "lastIntentPrefix": "VISITING" },
      "resolveTo": "VISITING_YACHT_PROVISIONING"
    },
    {
      "id": "maintenance_with_yacht_context",
      "when": { "concepts": ["maintenance"], "lastIntentPrefix": "YACHT" },
      "resolveTo": "MAINTENANCE"
    },
    {
      "id": "maintenance_short_followup",
      "when": { "concepts": ["maintenance"], "shortMessage": true, "lastIntentPrefix": "YACHT" },
      "resolveTo": "MAINTENANCE"
    },
    {
      "id": "berthing_with_marina_context",
      "when": { "concepts": ["berthing"], "lastIntentPrefix": "MARINA" },
      "resolveTo": "BERTHING"
    },
    {
      "id": "berthing_short_followup",
      "when": { "concepts": ["berthing"], "shortMessage": true, "lastIntentPrefix": "MARINA" },
      "resolveTo": "BERTHING"
    },
    {
      "id": "captain_with_crew_context",
      "when": { "concepts": ["captain"], "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_RECRUITMENT"
    },
    {
      "id": "captain_short_followup",
      "when": { "concepts": ["captain"], "shortMessage": true, "lastIntentPrefix": "CREW" },
      "resolveTo": "CREW_RECRUITMENT"
    },
    {
      "id": "management_scope_yacht_context",
      "when": { "concepts": ["management"], "lastIntentPrefix": "YACHT" },
      "resolveTo": "YACHT_MANAGEMENT"
    },
    {
      "id": "management_scope_marina_context",
      "when": { "concepts": ["management"], "lastIntentPrefix": "MARINA" },
      "resolveTo": "MARINA_MANAGEMENT"
    },
    {
      "id": "yacht_ownership_signal",
      "when": { "concepts": ["yacht"], "ownershipSignal": true },
      "resolveTo": "YACHT_MANAGEMENT"
    },
    {
      "id": "provisioning_agency",
      "when": { "clusters": ["provisioning"] },
      "resolveTo": "VISITING_YACHT_PROVISIONING"
    }
  ],
  "shortMessageMaxWords": 4,
  "contextIntentTtl": 10
}
